ANTHROPIC_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (service_role) do Supabase — Settings > API. NUNCA a publishable.
# Só usada no servidor (webhook da Kiwify), nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Token que a Kiwify mostra ao criar o webhook (Apps > Webhooks). Ela usa esse
# token pra assinar cada aviso (?signature=), e o app confere a assinatura.
KIWIFY_WEBHOOK_TOKEN=
