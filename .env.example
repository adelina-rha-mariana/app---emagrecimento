ANTHROPIC_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (service_role) do Supabase — Settings > API. NUNCA a publishable.
# Só usada no servidor (webhook da Kiwify), nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Valor aleatório inventado por você, colocado como ?secret= na URL do webhook
# cadastrado no painel da Kiwify (Apps > Webhooks).
KIWIFY_WEBHOOK_SECRET=
